package ecommerce.UseCases;

import ecommerce.Database.Repositories.ProductRepository;
import ecommerce.Database.Entites.Product;

import java.util.List;

public class ListAvailableProductsUseCase {

  private final ProductRepository repository;

  public ListAvailableProductsUseCase(ProductRepository repository) {
    this.repository = repository;
  }

  public List<Product> execute() {

    List<Product> products = repository.listAvailableProducts();

    return products;
  }
}
